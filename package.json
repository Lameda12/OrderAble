{
  "name": "orderable-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server that makes any food business orderable by AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "orderable": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "tsx scripts/team-lunch.ts > examples/team-lunch.md",
    "inspect": "npx @modelcontextprotocol/inspector node dist/cli.js serve --stdio --adapter mock"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "restaurant",
    "ordering",
    "ai-agents",
    "pos"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lameda12/OrderAble.git"
  },
  "homepage": "https://github.com/Lameda12/OrderAble#readme",
  "author": "Lameda12",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "types": "dist/index.d.ts"
}
